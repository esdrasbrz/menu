# Copy to .env.local for `npm run dev`. Production uses the MENU_* variables on the container
# instead — see the "Álbum" section of the README.

# Where Immich answers, with no trailing slash.
VITE_IMMICH_URL=http://192.168.0.10:2283

# The album to show: the id in http://<immich>/albums/<album-id>
VITE_IMMICH_ALBUM_ID=

# The key from that album's shared link: http://<immich>/share/<key>
VITE_IMMICH_SHARE_KEY=
